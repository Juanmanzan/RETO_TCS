// descubre los contenedores Docker
discovery.docker "contenedores" {
  host = "unix:///var/run/docker.sock"
}


// crea etiquetas útiles a partir de Docker
discovery.relabel "contenedores" {

  targets = discovery.docker.contenedores.targets

  // nombre del contenedor
  rule {
    source_labels = [
      "__meta_docker_container_name",
    ]

    regex        = "/(.*)"
    target_label = "container"
    replacement  = "$1"
  }

  // servicio definido en docker compose
  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_service",
    ]

    target_label = "service"
  }
}


// obtiene los logs producidos por Docker
loki.source.docker "contenedores" {

  host = "unix:///var/run/docker.sock"

  targets = discovery.docker.contenedores.targets

  relabel_rules = discovery.relabel.contenedores.rules

  forward_to = [
    loki.process.smartbancs.receiver,
  ]
}


// procesa los logs JSON generados por nuestras aplicaciones
loki.process "smartbancs" {

  // intenta extraer los campos del JSON
  stage.json {
    expressions = {
      nivel      = "nivel",
      componente = "componente",
      evento     = "evento",
    }
  }

  // solamente campos de baja cardinalidad
  // se convierten en labels de Loki
  stage.labels {
    values = {
      nivel      = "",
      componente = "",
      evento     = "",
    }
  }

  forward_to = [
    loki.write.local.receiver,
  ]
}


// envia los logs procesados hacia Loki
loki.write "local" {

  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}